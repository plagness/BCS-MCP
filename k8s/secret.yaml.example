apiVersion: v1
kind: Secret
metadata:
  name: bcs-secrets
  namespace: ns-bcs
type: Opaque
stringData:
  # Пароль для подключения к PostgreSQL
  BCS_DB_PASSWORD: ЗАПОЛНИТЬ_ПРИ_ДЕПЛОЕ
  # Токен обновления для MCP (опционально)
  BCS_REFRESH_TOKEN: ЗАПОЛНИТЬ_ПРИ_ДЕПЛОЕ
  # HTTP токен для MCP (опционально)
  MCP_HTTP_TOKEN: ЗАПОЛНИТЬ_ПРИ_ДЕПЛОЕ
